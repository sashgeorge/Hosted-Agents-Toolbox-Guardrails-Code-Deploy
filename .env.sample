# Copy to .env and fill in your own values:  cp .env.sample .env
# .env is gitignored. Never commit real endpoints, keys, or subscription IDs.

# -----------------------------------------------------------------------
# Foundry project
# -----------------------------------------------------------------------

# Data-plane endpoint. Foundry portal -> project -> Overview -> endpoint URL.
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"

# Model deployment the agent reasons with. Must already exist in the project.
#   az cognitiveservices account deployment list -n <account> -g <resource-group> -o table
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"

# -----------------------------------------------------------------------
# ARM coordinates of the Foundry (Azure AI Services) account.
# The account name is the host part of the project endpoint above.
# -----------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_RESOURCE_GROUP="<resource-group>"
AZURE_AI_ACCOUNT_NAME="<account>"

# -----------------------------------------------------------------------
# Sample resource names — safe to leave as-is.
# -----------------------------------------------------------------------
GUARDRAIL_NAME="telco-agent-guardrail"
TOOLBOX_NAME="telco-toolbox"
AGENT_NAME="telco-support-agent"
PROMPT_AGENT_NAME="telco-prompt-agent"

# Long-term memory store (09_create_memory_store.py). Leave blank to disable.
MEMORY_STORE_NAME="telco-memory"
# The store needs its own deployments. Chat defaults to the agent's model.
MEMORY_CHAT_MODEL=""
MEMORY_EMBEDDING_MODEL="text-embedding-3-large"

# Connection the prompt agent uses to reach the toolbox (06_deploy_prompt_agent.py).
TOOLBOX_CONNECTION_NAME="telco-toolbox-connection"
TOOLBOX_SERVER_LABEL="telcotoolbox"

# Set to "true" to also provision the preview network-egress rules
# (01_create_guardrail.py). Leave "false" for content filters only.
ENABLE_EGRESS_GUARDRAIL="false"

# -----------------------------------------------------------------------
# Remote MCP server added to the toolbox by 05_update_toolbox.py.
# Optional — only needed if you run that script.
# DYNAMIC_WF_MCP_KEY is a secret: keep it out of source control.
# -----------------------------------------------------------------------
# Must be the full MCP path, not just the host (most servers answer on /mcp).
DYNAMIC_WF_MCP_URL="https://<your-mcp-host>/mcp"
DYNAMIC_WF_MCP_HEADER="x-api-key"
DYNAMIC_WF_MCP_KEY="<api-key>"
DYNAMIC_WF_MCP_CONNECTION_NAME="dynamic-wf-mcp"
DYNAMIC_WF_MCP_SERVER_LABEL="dynamicwf"
